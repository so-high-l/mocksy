# Required in production. Choose a strong private password.
APP_PASSWORD=replace_with_your_private_password

# Required in production. Use a long, random value (at least 32 characters).
SESSION_SECRET=replace_with_a_long_random_secret

# Recommended for Vercel. You can also connect this from the protected settings page.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Powers FLUX.2 Klein 9B. Create or manage keys at https://dashboard.bfl.ai/
BFL_API_KEY=your_bfl_api_key_here

# Powers GPT-4o mini frame matching. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Etsy draft publishing. Create an app at https://www.etsy.com/developers/your-apps
# and register this exact callback URL in the app settings.
ETSY_API_KEY=your_etsy_app_keystring
ETSY_SHARED_SECRET=your_etsy_app_shared_secret
ETSY_REDIRECT_URI=https://your-public-domain.example/api/etsy/callback

# Optional: preselect a seller taxonomy/category ID for every listing.
ETSY_TAXONOMY_ID=
